{
  "expo": {
    "name": "Lily Community Center",
    "slug": "lily-community-center",
    "scheme": "lilycc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lilycommunity.center",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow Lily Community Center to access your photo library to upload club logos and receipt images.",
        "NSCameraUsageDescription": "Allow Lily Community Center to use the camera to capture payment receipts.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.lilycommunity.center",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "usesCleartextTraffic": false
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "0ccd6088-a506-4db4-a284-88db7c3e3603"
      }
    },
    "owner": "emondaa"
  }
}
