# =====================================================================
# Lily Community Center - Environment Configuration Template
# All secrets here are FAKE placeholders. Copy to .env and configure.
# Never commit a real .env file to version control.
# =====================================================================

# Application Environment: 'production' or 'development'
# In production: secure cookies enabled, HTTPS enforced, debug off, stack traces hidden.
APP_ENV=development

# Server Port
PORT=3000

# Public Application URL (Used for Google OAuth redirect callback)
# Example for local development: http://localhost:3000
# Example for production: https://lily.example.com
PUBLIC_APP_URL=http://localhost:3000

# Database Connection (SQLite file path)
DATABASE_URL=./data/lilycc.db

# Cryptographically secure random session signing secret
# Must be at least 32 characters long. In production, placeholder strings are rejected.
SESSION_SECRET=example_fake_session_secret_replace_with_64_random_hex_characters_in_real_env_0123456789

# Session Idle Timeout (in minutes, default: 30)
# Session expires if the user makes no request within this timeframe.
SESSION_IDLE_TIMEOUT_MINUTES=30

# Session Absolute Timeout (in hours, default: 12)
# Hard expiration for any session regardless of activity.
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# Join Code Rate Limiting: Maximum incorrect attempts allowed before temporary lockout (default: 5)
JOIN_RATE_LIMIT_MAX_ATTEMPTS=5

# Join Code Lockout Duration (in minutes, default: 15)
JOIN_LOCKOUT_MINUTES=15

# Google OAuth 2.0 Client Credentials
# Create these in Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=fake_google_client_id_placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=fake_google_client_secret_placeholder_GOCSPX-dummy

# Development-only Quick Login helper (strictly ignored / rejected in production)
DEV_LOGIN_ENABLED=true
